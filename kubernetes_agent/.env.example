# =============================================================
# AIOps Agent — Environment Variables
# =============================================================
# Copy this file to .env and fill in the values.
# DO NOT commit .env to version control.
# =============================================================

# --- Kubernetes ---
# Set to false when running outside the cluster (local dev)
AIOPS_K8S_IN_CLUSTER=true
# Path to kubeconfig file (only used when K8S_IN_CLUSTER=false)
# AIOPS_K8S_KUBECONFIG=~/.kube/config

# --- Gemini LLM ---
AIOPS_GEMINI_API_KEY=your-gemini-api-key-here
# AIOPS_GEMINI_MODEL=gemini-2.5-flash
# AIOPS_GEMINI_TEMPERATURE=0.2
# AIOPS_GEMINI_MAX_TOKENS=4096
# AIOPS_GEMINI_TIMEOUT_SECONDS=30

# --- Scanning ---
# AIOPS_SCAN_INTERVAL_SECONDS=60
# AIOPS_RESTART_THRESHOLD=5
# AIOPS_RESTART_WINDOW_SECONDS=1800
# AIOPS_PENDING_THRESHOLD_SECONDS=300

# --- Log Collection ---
# AIOPS_LOG_TAIL_LINES=500
# AIOPS_LOG_SINCE_SECONDS=3600
# AIOPS_LOG_MAX_BYTES=51200

# --- Security ---
# AIOPS_SANITIZE_LOGS=true

# --- API ---
# AIOPS_API_HOST=0.0.0.0
# AIOPS_API_PORT=8000
# AIOPS_API_KEY=optional-api-key-for-auth
