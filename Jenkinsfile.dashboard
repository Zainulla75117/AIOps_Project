pipeline {
    agent any

    environment {
        // Docker credentials ID as provided
        DOCKER_CREDS_ID = 'zain_docker_creds'
        
        // Define Image Name based on existing Kubernetes manifests
        DASHBOARD_IMAGE = 'zain75117/aiops-k8s-dashboard'
        
        // Use Jenkins BUILD_NUMBER as the image tag for versioning
        IMAGE_TAG = "${env.BUILD_NUMBER}"
    }

    stages {
        stage('Build Docker Image') {
            steps {
                script {
                    echo "Building Dashboard Image: ${DASHBOARD_IMAGE}:${IMAGE_TAG}"
                    docker.build("${DASHBOARD_IMAGE}:${IMAGE_TAG}", "-f dashboard/Dockerfile dashboard/")
                }
            }
        }
        
        stage('Push Docker Image') {
            steps {
                script {
                    echo "Pushing Image to Registry..."
                    docker.withRegistry('', DOCKER_CREDS_ID) {
                        docker.image("${DASHBOARD_IMAGE}:${IMAGE_TAG}").push()
                        sh "docker tag ${DASHBOARD_IMAGE}:${IMAGE_TAG} ${DASHBOARD_IMAGE}:latest"
                        docker.image("${DASHBOARD_IMAGE}:latest").push()
                    }
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                script {
                    echo "Deploying Dashboard to Kubernetes using Service Account..."
                    
                    // Update image tag in dashboard k8s manifest to the newly built image tag
                    sh """
                    sed -i "s|image: ${DASHBOARD_IMAGE}:.*|image: ${DASHBOARD_IMAGE}:${IMAGE_TAG}|g" kubernetes/dashboard.yaml
                    
                    # Apply the dashboard manifest
                    kubectl apply -f kubernetes/dashboard.yaml
                    """
                }
            }
        }
    }
    
    post {
        always {
            cleanWs()
        }
        success {
            echo 'Dashboard Pipeline completed successfully!'
        }
        failure {
            echo 'Dashboard Pipeline failed. Check the logs for details.'
        }
    }
}
